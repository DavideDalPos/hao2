    <!-- http://purl.obolibrary.org/obo/AISM_0000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AISM_0000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AISM_0000174"/>
        <rdfs:subClassOf rdf:nodeID="genid361"/>
        <obo:IAO_0000115 xml:lang="en">The region of cuticle that is composed two articular surfaces that are adjacent to each other.</obo:IAO_0000115>
        <obo:IAO_0000232>Articulations are &apos;anatomical clusters&apos;, collections of not direclty connected (continuous) sclerite surfaces that are adjacent to another sclerite. The cranio-mandibular articulation is the articular surface of the cranium and the adjacent articular surface of the mandible. The articular surfaces are sometimes located on the same sclerite.</obo:IAO_0000232>
        <rdfs:label>insect articulation</rdfs:label>
    </owl:Class>
