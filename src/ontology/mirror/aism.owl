        <oboI:hasDbXref>MESH:D009399</oboI:hasDbXref>
        <oboI:hasDbXref>NCIT:C13048</oboI:hasDbXref>
        <oboI:hasDbXref>SCTID:361337001</oboI:hasDbXref>
        <oboI:hasDbXref>TAO:0002153</oboI:hasDbXref>
