        <oboI:hasDbXref>OGES:000020</oboI:hasDbXref>
        <oboI:hasDbXref>PdumDv:0000200</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Cleavage_(embryo)</oboI:hasDbXref>
        <oboI:hasDbXref>XAO:1000004</oboI:hasDbXref>
        <oboI:hasDbXref>ZFS:0000046</oboI:hasDbXref>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0000107</oboI:id>
        <rdfs:label>cleavage stage</rdfs:label>
    </owl:Class>
