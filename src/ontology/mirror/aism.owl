        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0061241"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process whose specific outcome is the progression of the mesonephric nephron epithelium over time, from its formation to the mature structure. An epithelium is a tissue that covers the internal or external surfaces of an anatomical structure. The mesonephric nephron epithelium is a tissue that covers the surface of a nephron in the mesonephros.</owl:annotatedTarget>
        <oboI:hasDbXref>GOC:mtg_kidney_jan10</oboI:hasDbXref>
    </owl:Axiom>
    


