    <!-- http://purl.obolibrary.org/obo/GO_0007588 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0007588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0003008"/>
        <obo:IAO_0000115>The elimination by an organism of the waste products that arise as a result of metabolic activity. These products include water, carbon dioxide (CO2), and nitrogenous compounds.</obo:IAO_0000115>
        <oboI:hasDbXref>Wikipedia:Excretion</oboI:hasDbXref>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0007588</oboI:id>
        <rdfs:label>excretion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
