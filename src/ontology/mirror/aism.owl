    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35107 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35107">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35106"/>
        <obo:IAO_0000115>Saturated acyclic nitrogen hydrides having the general formula NnHn+2.</obo:IAO_0000115>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35107</oboI:id>
        <rdfs:label>azane</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35222 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35222">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_24432"/>
        <obo:IAO_0000115>A substance that diminishes the rate of a chemical reaction.</obo:IAO_0000115>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35222</oboI:id>
        <rdfs:label>inhibitor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35223 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35223">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51086"/>
        <obo:IAO_0000115>A substance that increases the rate of a reaction without modifying the overall standard Gibbs energy change in the reaction.</obo:IAO_0000115>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35223</oboI:id>
        <rdfs:label>catalyst</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_27369"/>
        <obo:IAO_0000115>The zwitterionic form of an amino acid having a negatively charged carboxyl group and a positively charged amino group.</obo:IAO_0000115>
        <oboI:hasExactSynonym>amino acid zwitterion</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35238</oboI:id>
        <rdfs:label>amino acid zwitterion</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35238"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>amino acid zwitterion</owl:annotatedTarget>
        <oboI:hasDbXref>ChEBI</oboI:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_25697"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35274"/>
        <obo:IAO_0000115>A derivative of ammonium, NH4(+), in which all four of the hydrogens bonded to nitrogen have been replaced with univalent (usually organyl) groups.</obo:IAO_0000115>
        <oboI:hasDbXref>KEGG:C06703</oboI:hasDbXref>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35267</oboI:id>
        <rdfs:label>quaternary ammonium ion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35274 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35274">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33702"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51143"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/chebi#has_parent_hydride"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_28938"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A derivative of ammonium, NH4(+), in which one (or more) of the hydrogens bonded to the nitrogen have been replaced with univalent organyl groups. The substituting carbon of the organyl group must not itself be directly attached to a heteroatom (thereby excluding protonated amides, hemiaminals, etc).</obo:IAO_0000115>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35274</oboI:id>
        <rdfs:label>ammonium ion derivative</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35287 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35287">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35267"/>
        <obo:IAO_0000115>A choline ester formed from choline and a carboxylic acid.</obo:IAO_0000115>
        <oboI:hasDbXref>KEGG:C01777</oboI:hasDbXref>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35287</oboI:id>
        <rdfs:label>acylcholine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CHEBI_35341 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CHEBI_35341">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_18059"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_51958"/>
        <obo:IAO_0000115>Any of naturally occurring compounds and synthetic analogues, based on the cyclopenta[a]phenanthrene carbon skeleton, partially or completely hydrogenated; there are usually methyl groups at C-10 and C-13, and often an alkyl group at C-17. By extension, one or more bond scissions, ring expansions and/or ring contractions of the skeleton may have occurred. Natural steroids are derived biogenetically from squalene which is a triterpene.</obo:IAO_0000115>
        <oboI:hasDbXref>KEGG:C00377</oboI:hasDbXref>
        <oboI:hasDbXref>MetaCyc:Steroids</oboI:hasDbXref>
        <oboI:hasExactSynonym>Steroid</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:35341</oboI:id>
        <rdfs:label>steroid</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_35341"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>Steroid</owl:annotatedTarget>
        <oboI:hasDbXref>KEGG_COMPOUND</oboI:hasDbXref>
    </owl:Axiom>
    


