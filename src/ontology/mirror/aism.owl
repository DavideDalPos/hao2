            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An anatomical cavity that surrounded_by a synovial joint.</obo:IAO_0000115>
        <oboI:hasDbXref>FMA:11356</oboI:hasDbXref>
        <oboI:hasExactSynonym>articular cavity (synovial joint)</oboI:hasExactSynonym>
