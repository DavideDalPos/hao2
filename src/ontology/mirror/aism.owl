        <oboI:hasDbXref>Wikipedia:Descending_aorta</oboI:hasDbXref>
        <oboI:hasExactSynonym>pars descendens aortae</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
