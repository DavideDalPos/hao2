        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0004027</oboI:id>
        <rdfs:label>chorionic plate</rdfs:label>
        <x_0.1:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://ccf-ontology.hubmapconsortium.org/objects/v1.2/VH_F_Placenta.glb</x_0.1:depiction>
    </owl:Class>
