        <obo:IAO_0000115>A specialized eukaryotic organelle that consists of a filiform extrusion of the cell surface and of some cytoplasmic parts. Each cilium is largely bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored to a basal body.</obo:IAO_0000115>
        <oboI:hasDbXref>FMA:67181</oboI:hasDbXref>
        <oboI:hasDbXref>NIF_Subcellular:sao787716553</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Cilium</oboI:hasDbXref>
        <oboI:hasExactSynonym>eukaryotic flagellum</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>microtubule-based flagellum</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>cellular_component</oboI:hasOBONamespace>
        <oboI:id>GO:0005929</oboI:id>
        <rdfs:label>cilium</rdfs:label>
    </owl:Class>
