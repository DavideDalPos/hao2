        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0001206"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0004854"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0007826"/>
        <obo:IAO_0000115>The peritoneum responsible for connecting the jejunum and ileum (parts of the small intestine) to the back wall of the abdomen. Between the two sheets of peritoneum are blood vessels, lymph vessels, and nerves. This allows these parts of the small intestine to move relatively freely within the abdominopelvic cavity. The brain, however, cannot map sensation accurately, so sensation is usually referred to the midline, an example of referred pain[WP].</obo:IAO_0000115>
        <oboI:hasDbXref>EMAPA:37745</oboI:hasDbXref>
        <oboI:hasDbXref>FMA:14643</oboI:hasDbXref>
        <oboI:hasDbXref>MA:0001555</oboI:hasDbXref>
        <oboI:hasDbXref>SCTID:245456008</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Mesentery#Mesentery_.28proper.29</oboI:hasDbXref>
        <oboI:hasExactSynonym>mesentery (proper)</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>mesentery proper</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>small intestinal mesentery</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>small intestine mesentery</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0001170</oboI:id>
        <rdfs:label>mesentery of small intestine</rdfs:label>
    </owl:Class>
