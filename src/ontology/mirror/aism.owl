        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
        <obo:IAO_0000115>p acts on population of c iff c&apos; is a collection, has members of type c, and p has participant c</obo:IAO_0000115>
        <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2020-06-08T17:21:33Z</oboI:creation_date>
        <oboI:hasDbXref>RO:0012003</oboI:hasDbXref>
        <rdfs:label xml:lang="en">acts on population of</rdfs:label>
    </owl:ObjectProperty>
    


