    <!-- http://purl.obolibrary.org/obo/GO_0019827 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0019827">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/GO_0098727"/>
                    <owl:Restriction>
