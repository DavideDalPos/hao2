        <oboI:hasDbXref>NCIT:C32356</oboI:hasDbXref>
        <oboI:hasDbXref>SCTID:245403006</oboI:hasDbXref>
        <oboI:hasDbXref>UMLS:C0019149</oboI:hasDbXref>
        <oboI:hasDbXref>VHOG:0000220</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Common_hepatic_duct</oboI:hasDbXref>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0001175</oboI:id>
        <rdfs:label>common hepatic duct</rdfs:label>
        <x_0.1:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/4/48/Illu_liver_gallbladder.jpg</x_0.1:depiction>
