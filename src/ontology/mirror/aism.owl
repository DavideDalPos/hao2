    <!-- http://purl.obolibrary.org/obo/UBERON_0034728 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/UBERON_0034728">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011779"/>
