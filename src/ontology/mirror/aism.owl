                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000115 xml:lang="en">Relation between an anatomical structure (including cells) and a neuron that chemically synapses to it. </obo:IAO_0000115>
        <oboI:hasDbXref>RO:0002103</oboI:hasDbXref>
