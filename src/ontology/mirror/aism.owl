        <oboI:hasDbXref>NCIT:C34131</oboI:hasDbXref>
        <oboI:hasDbXref>UMLS:C1516779</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Conceptus</oboI:hasDbXref>
        <oboI:hasExactSynonym>embryo plus adnexa</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0004716</oboI:id>
        <rdfs:label>conceptus</rdfs:label>
    </owl:Class>
