            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The regulated release of neurotransmitter from the presynapse into the synaptic cleft via calcium-regulated exocytosis during synaptic transmission.</obo:IAO_0000115>
        <oboI:hasExactSynonym>neurotransmitter release</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>neurotransmitter secretory pathway</oboI:hasExactSynonym>
