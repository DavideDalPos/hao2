    <!-- http://purl.obolibrary.org/obo/AISM_0000404 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AISM_0000404">
        <obo:IAO_0000115>The object property of an object consisting of having a measurement unit.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has_unit</rdfs:label>
    </owl:ObjectProperty>
    <owl:Axiom>
