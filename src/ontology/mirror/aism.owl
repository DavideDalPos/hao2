        <oboI:hasExactSynonym>cartilage organ development</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>chondrogenesis</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0051216</oboI:id>
        <rdfs:label>cartilage development</rdfs:label>
