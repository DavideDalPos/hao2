        <oboI:hasDbXref>Wikipedia:Thoracic_nerves</oboI:hasDbXref>
        <oboI:hasDbXref>neuronames:1725</oboI:hasDbXref>
        <oboI:hasExactSynonym>thoracic spinal nerve</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0003726</oboI:id>
        <rdfs:label>thoracic nerve</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/UBERON_0003726"/>
