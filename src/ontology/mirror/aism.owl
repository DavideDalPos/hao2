        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002518"/>
        <obo:IAO_0000115>A cuboidal epithelial cell of the kidney which regulates sodium and potassium balance. The activity of sodium and potassium channels on the apical membrane of the cell is regulated by aldosterone and vasopressin. In mammals this cell type is located in the renal collecting duct system.</obo:IAO_0000115>
        <rdfs:label>renal principal cell</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0005009"/>
