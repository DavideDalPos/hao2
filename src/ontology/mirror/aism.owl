        <oboI:hasDbXref>NCIT:C12957</oboI:hasDbXref>
        <oboI:hasDbXref>UMLS:C1516995</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Exocrine_gland</oboI:hasDbXref>
        <oboI:hasDbXref>WikipediaCategory:Exocrine_system</oboI:hasDbXref>
        <oboI:hasExactSynonym>exocrine glandular system</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0002330</oboI:id>
        <rdfs:label>exocrine system</rdfs:label>
