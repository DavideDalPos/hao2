        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>pulmonary neuroendocrine cell</owl:annotatedTarget>
        <oboI:hasDbXref>PMID:33355253</oboI:hasDbXref>
    </owl:Axiom>
    


