        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33247"/>
        <obo:IAO_0000115>An organic group formed by removing one or more hydroxy groups from an oxoacid that has the general structure RkE(=O)l(OH)m (l =/= 0). Although the term is almost always applied to organic compounds, with carboxylic acid as the oxoacid, acyl groups can in principle be derived from other types of acids such as sulfonic acids or phosphonic acids.</obo:IAO_0000115>
        <oboI:hasExactSynonym>acyl group</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>chebi_ontology</oboI:hasOBONamespace>
        <oboI:id>CHEBI:22221</oboI:id>
        <rdfs:label>acyl group</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CHEBI_22221"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasExactSynonym"/>
        <owl:annotatedTarget>acyl group</owl:annotatedTarget>
        <oboI:hasDbXref>IUPAC</oboI:hasDbXref>
    </owl:Axiom>
    


