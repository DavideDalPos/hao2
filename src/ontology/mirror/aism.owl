                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002473"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0011825"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thin layer of loose connective tissue which lies beneath the epithelium and together with the epithelium constitutes the mucosa[WP]. The lamina propria contains capillaries and a central lacteal (lymph vessel) in the small intestine, as well as lymphoid tissue. Lamina propria also contains glands with the ducts opening on to the mucosal epithelium, that secrete mucus and serous secretions.</obo:IAO_0000115>
        <oboI:hasDbXref>BTO:0002330</oboI:hasDbXref>
        <oboI:hasDbXref>FMA:62517</oboI:hasDbXref>
        <oboI:hasDbXref>NCIT:C32918</oboI:hasDbXref>
        <oboI:hasDbXref>SCTID:298225002</oboI:hasDbXref>
        <oboI:hasDbXref>UMLS:C1179187</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Lamina_propria</oboI:hasDbXref>
        <oboI:hasExactSynonym>lamina propria mucosa</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>lamina propria mucosae</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0000030</oboI:id>
        <rdfs:label>lamina propria</rdfs:label>
        <x_0.1:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://upload.wikimedia.org/wikipedia/commons/f/fb/GI_Organization.svg</x_0.1:depiction>
    </owl:Class>
