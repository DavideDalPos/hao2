        <oboI:hasDbXref>VSAO:0000049</oboI:hasDbXref>
        <oboI:hasDbXref>XAO:0003075</oboI:hasDbXref>
        <oboI:hasDbXref>ZFA:0000737</oboI:hasDbXref>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0010323</oboI:id>
        <rdfs:label>cranial skeletal system</rdfs:label>
    </owl:Class>
