    <!-- http://purl.obolibrary.org/obo/AISM_0000377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AISM_0000377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/AISM_0000180"/>
        <rdfs:subClassOf rdf:nodeID="genid3033"/>
        <rdfs:subClassOf rdf:nodeID="genid3039"/>
        <obo:IAO_0000115 xml:lang="en">The cuticular carina that is located on the proximal margin of the 8th tergite and is parallel to the left-right body axis.</obo:IAO_0000115>
        <obo:IAO_0000232>In Scarabaeinae, this carina (when present) is located in the proximalmost margin of the surface of the 8th tergite (pygidium) that is not covered by elytra.</obo:IAO_0000232>
        <oboI:hasExactSynonym xml:lang="en">pygidium basal ridge</oboI:hasExactSynonym>
        <rdfs:label xml:lang="en">proximal carina of tergite VIII</rdfs:label>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid3033">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
        <owl:someValuesFrom>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BSPO_0000677"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
