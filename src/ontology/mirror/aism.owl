        <oboI:hasExactSynonym>isthmus development</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>midbrain-hindbrain orgainizer development</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0030917</oboI:id>
        <rdfs:label>midbrain-hindbrain boundary development</rdfs:label>
    </owl:Class>
