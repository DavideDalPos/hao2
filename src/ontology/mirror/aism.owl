        <oboI:hasDbXref>EMAPA:18606</oboI:hasDbXref>
        <oboI:hasDbXref>SCTID:338637006</oboI:hasDbXref>
        <oboI:hasDbXref>TAO:0000014</oboI:hasDbXref>
        <oboI:hasDbXref>VHOG:0000264</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Dorsal_aorta</oboI:hasDbXref>
        <oboI:hasDbXref>XAO:0000051</oboI:hasDbXref>
        <oboI:hasDbXref>ZFA:0000014</oboI:hasDbXref>
        <oboI:hasExactSynonym>DA</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0005805</oboI:id>
        <rdfs:label>dorsal aorta</rdfs:label>
        <x_0.1:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/f/fb/Gray459.png</x_0.1:depiction>
    </owl:Class>
