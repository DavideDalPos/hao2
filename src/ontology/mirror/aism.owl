        <rdfs:subClassOf rdf:nodeID="genid2182"/>
        <rdfs:subClassOf rdf:nodeID="genid2184"/>
        <obo:IAO_0000115 xml:lang="en">The orifice that is contained by the cuticle and connects the inside of the insect with the outside, is tubular, and whose diameter is smaller than 100 nm.</obo:IAO_0000115>
        <obo:IAO_0000232 xml:lang="en">Should coincide with &apos;exactly one&apos; epithelial cell, but that violates OWL specs.</obo:IAO_0000232>
        <rdfs:label xml:lang="en">pore canal</rdfs:label>
    </owl:Class>
