        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0060675"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The process in which the branching structure of the ureteric bud is generated and organized. The ureteric bud is an epithelial tube that grows out from the metanephric duct. The bud elongates and branches to give rise to the ureter and kidney collecting tubules.</obo:IAO_0000115>
        <oboI:hasExactSynonym>ureteric bud branching</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0001658</oboI:id>
        <rdfs:label>branching involved in ureteric bud morphogenesis</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0001658"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The process in which the branching structure of the ureteric bud is generated and organized. The ureteric bud is an epithelial tube that grows out from the metanephric duct. The bud elongates and branches to give rise to the ureter and kidney collecting tubules.</owl:annotatedTarget>
        <oboI:hasDbXref>GOC:dph</oboI:hasDbXref>
        <oboI:hasDbXref>PMID:16916378</oboI:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
