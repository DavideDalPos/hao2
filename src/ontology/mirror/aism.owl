        <oboI:hasDbXref>RETIRED_EHDAA2:0002201</oboI:hasDbXref>
        <oboI:hasDbXref>SCTID:118760003</oboI:hasDbXref>
        <oboI:hasDbXref>UMLS:C0042779</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Viscus</oboI:hasDbXref>
        <oboI:hasDbXref>XAO:0003034</oboI:hasDbXref>
