        <oboI:hasDbXref>GOC:dgh</oboI:hasDbXref>
        <oboI:hasDbXref>GOC:dph</oboI:hasDbXref>
        <oboI:hasDbXref>GOC:jid</oboI:hasDbXref>
        <oboI:hasDbXref>GO_REF:0000021</oboI:hasDbXref>
        <oboI:hasDbXref>PMID:11262869</oboI:hasDbXref>
    </owl:Axiom>
    


