        <oboI:hasExactSynonym>basement membrane of connective tissue</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0005769</oboI:id>
        <rdfs:label>basement membrane of epithelium</rdfs:label>
