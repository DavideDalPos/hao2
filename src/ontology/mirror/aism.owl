    <!-- http://purl.obolibrary.org/obo/AISM_0000079 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/AISM_0000079">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002150"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <obo:IAO_0000115 xml:lang="en">Structure y is encircled by structure x if both x and y are regions of the 2D structure z, or 2D cross-sections of a 3D object z, and the boundary of y on z is exclusively continuous with y.</obo:IAO_0000115>
