        <oboI:hasDbXref>TAO:0000393</oboI:hasDbXref>
        <oboI:hasDbXref>UMLS:C0162415</oboI:hasDbXref>
        <oboI:hasDbXref>VHOG:0000170</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Mesenchyme</oboI:hasDbXref>
        <oboI:hasDbXref>XAO:0003046</oboI:hasDbXref>
        <oboI:hasDbXref>ZFA:0000393</oboI:hasDbXref>
        <oboI:hasExactSynonym>mesenchymal tissue</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>mesenchyme tissue</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>portion of mesenchymal tissue</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>portion of mesenchyme tissue</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0003104</oboI:id>
        <rdfs:label>mesenchyme</rdfs:label>
        <x_0.1:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/f/f4/Mesenchymal_Stem_Cell.jpg</x_0.1:depiction>
    </owl:Class>
