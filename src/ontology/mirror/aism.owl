        <obo:IAO_0000115>The assembly of a cilium, a specialized eukaryotic organelle that consists of a filiform extrusion of the cell surface. Each cilium is bounded by an extrusion of the cytoplasmic membrane, and contains a regular longitudinal array of microtubules, anchored basally in a centriole.</obo:IAO_0000115>
        <oboI:hasDbXref>Reactome:R-HSA-5617833.2</oboI:hasDbXref>
        <oboI:hasExactSynonym>ciliogenesis</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>cilium formation</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>microtubule-based flagellum assembly</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0060271</oboI:id>
        <rdfs:label>cilium assembly</rdfs:label>
    </owl:Class>
