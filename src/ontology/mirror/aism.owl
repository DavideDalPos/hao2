        <oboI:hasDbXref>OGES:000021</oboI:hasDbXref>
        <oboI:hasDbXref>WBls:0000005</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Blastula</oboI:hasDbXref>
        <oboI:hasDbXref>XAO:1000003</oboI:hasDbXref>
        <oboI:hasDbXref>ZFS:0000045</oboI:hasDbXref>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0000108</oboI:id>
        <rdfs:label>blastula stage</rdfs:label>
        <x_0.1:depiction rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://upload.wikimedia.org/wikipedia/commons/c/c6/Blastulation.png</x_0.1:depiction>
