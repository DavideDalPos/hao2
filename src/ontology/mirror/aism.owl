                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/UBERON_0002330"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Progression of the exocrine system over time, from its formation to a mature structure. The exocrine system is a system of hormones and glands, where the glands secrete straight to a target site via ducts or tubes. The human exocrine system includes the salivary glands, sweat glands and many glands of the digestive system.</obo:IAO_0000115>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0035272</oboI:id>
        <rdfs:label>exocrine system development</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0035272"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Progression of the exocrine system over time, from its formation to a mature structure. The exocrine system is a system of hormones and glands, where the glands secrete straight to a target site via ducts or tubes. The human exocrine system includes the salivary glands, sweat glands and many glands of the digestive system.</owl:annotatedTarget>
        <oboI:hasDbXref>GOC:bf</oboI:hasDbXref>
        <oboI:hasDbXref>Wikipedia:Exocrine_gland</oboI:hasDbXref>
    </owl:Axiom>
    


