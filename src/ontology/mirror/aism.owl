        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A developmental process, independent of morphogenetic (shape) change, that is required for a myoblast to attain its fully functional state. A myoblast is a mononucleate cell type that, by fusion with other myoblasts, gives rise to the myotubes that eventually develop into skeletal muscle fibers.</owl:annotatedTarget>
        <oboI:hasDbXref>CL:0000056</oboI:hasDbXref>
        <oboI:hasDbXref>GOC:dph</oboI:hasDbXref>
        <oboI:hasDbXref>GOC:mtg_muscle</oboI:hasDbXref>
    </owl:Axiom>
    


