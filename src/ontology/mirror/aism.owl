        <oboI:hasExactSynonym>atlanto axial joint</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>atlantoaxial joint</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
