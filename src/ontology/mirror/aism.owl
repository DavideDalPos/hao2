        <oboI:hasDbXref>SCTID:281055007</oboI:hasDbXref>
        <oboI:hasDbXref>UMLS:C0226754</oboI:hasDbXref>
        <oboI:hasDbXref>VHOG:0001118</oboI:hasDbXref>
