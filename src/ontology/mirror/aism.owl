            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0004047"/>
        </owl:propertyChainAxiom>
        <oboI:creation_date rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2018-01-26T23:49:30Z</oboI:creation_date>
        <oboI:hasDbXref>RO:0004032</oboI:hasDbXref>
