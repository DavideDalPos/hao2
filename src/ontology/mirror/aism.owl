        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/GO_0050981"/>
        <obo:IAO_0000115>The series of events by which an electrical stimulus is received and converted into a molecular signal. This occurs as part of the regulation of muscle adaptation.</obo:IAO_0000115>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0014879</oboI:id>
        <rdfs:label>detection of electrical stimulus involved in regulation of muscle adaptation</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0014879"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The series of events by which an electrical stimulus is received and converted into a molecular signal. This occurs as part of the regulation of muscle adaptation.</owl:annotatedTarget>
        <oboI:hasDbXref>GOC:ef</oboI:hasDbXref>
        <oboI:hasDbXref>GOC:mtg_muscle</oboI:hasDbXref>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/GO_0014887 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/GO_0014887">
