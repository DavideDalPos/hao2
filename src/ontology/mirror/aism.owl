        <oboI:hasExactSynonym>neural tube metameric segment</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>neural tube segment</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>neuromere</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0004731</oboI:id>
