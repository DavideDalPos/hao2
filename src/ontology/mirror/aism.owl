        <obo:IAO_0000115>The layer of the myocardium composed of projections of contractile myocytes. The trabecular layer is bounded internally by the endocardium. In zebrafish, unlike the trabeculations of higher vertebrates, both atrial and ventricular trabeculae have more strut-like character, and are more uniform without apparent regional differences[ZFA].</obo:IAO_0000115>
        <oboI:hasDbXref>EFO:0003706</oboI:hasDbXref>
        <oboI:hasDbXref>MA:0002866</oboI:hasDbXref>
        <oboI:hasDbXref>TAO:0005059</oboI:hasDbXref>
        <oboI:hasDbXref>ZFA:0005059</oboI:hasDbXref>
        <oboI:hasExactSynonym>myocardial trabecular layer</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>trabecular layer</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0004124</oboI:id>
        <rdfs:label>myocardium trabecular layer</rdfs:label>
    </owl:Class>
