    <!-- http://purl.obolibrary.org/obo/AISM_0000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/AISM_0000177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/UBERON_0000161"/>
