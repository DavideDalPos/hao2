        <oboI:hasExactSynonym>urogenital fold</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0004876</oboI:id>
        <rdfs:label>urogenital fold</rdfs:label>
