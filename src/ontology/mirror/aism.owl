        <oboI:hasExactSynonym>mesonephric kidney</oboI:hasExactSynonym>
        <oboI:hasOBONamespace>uberon</oboI:hasOBONamespace>
        <oboI:id>UBERON:0000080</oboI:id>
        <rdfs:label>mesonephros</rdfs:label>
