                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0045165"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any process that stops, prevents or reduces the frequency or rate of cell fate commitment. Cell fate commitment is the commitment of cells to specific cell fates and their capacity to differentiate into particular kinds of cells. Positional information is established through protein signals that emanate from a localized source within a cell (the initial one-cell zygote) or within a developmental field.</obo:IAO_0000115>
        <oboI:hasOBONamespace>biological_process</oboI:hasOBONamespace>
        <oboI:id>GO:0010454</oboI:id>
        <rdfs:label>negative regulation of cell fate commitment</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/GO_0010454"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Any process that stops, prevents or reduces the frequency or rate of cell fate commitment. Cell fate commitment is the commitment of cells to specific cell fates and their capacity to differentiate into particular kinds of cells. Positional information is established through protein signals that emanate from a localized source within a cell (the initial one-cell zygote) or within a developmental field.</owl:annotatedTarget>
        <oboI:hasDbXref>GOC:dph</oboI:hasDbXref>
        <oboI:hasDbXref>GOC:tb</oboI:hasDbXref>
    </owl:Axiom>
    


