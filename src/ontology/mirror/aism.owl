        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CL_0002086"/>
        <obo:IAO_0000115>Specialized cardiac myocyte that is subendocardially interspersed with the regular cardiac muscle cell. They are uninucleate cylindrical cells, associated end-to-end in long rows, continue from the node to the atrioventricular bundle; relatively short compared to ordinary myocytes but are nearly twice their diameter.</obo:IAO_0000115>
        <oboI:creation_date>2010-06-28T08:36:15Z</oboI:creation_date>
        <oboI:hasDbXref>BTO:0001032</oboI:hasDbXref>
        <oboI:hasDbXref>FMA:14146</oboI:hasDbXref>
        <oboI:hasExactSynonym>Purkinje cell fiber</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>Purkinje muscle cell</oboI:hasExactSynonym>
        <oboI:hasExactSynonym>myocytus conducens cardiacus</oboI:hasExactSynonym>
        <rdfs:label>Purkinje myocyte</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/CL_0002068"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Specialized cardiac myocyte that is subendocardially interspersed with the regular cardiac muscle cell. They are uninucleate cylindrical cells, associated end-to-end in long rows, continue from the node to the atrioventricular bundle; relatively short compared to ordinary myocytes but are nearly twice their diameter.</owl:annotatedTarget>
        <oboI:hasDbXref>FMA:0412046911</oboI:hasDbXref>
        <oboI:hasDbXref>GOC:tfm</oboI:hasDbXref>
        <oboI:hasDbXref>PMID:19939742</oboI:hasDbXref>
    </owl:Axiom>
    


